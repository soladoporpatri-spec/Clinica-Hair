# =============================================================================
#  barbearia.service — Unit systemd para Nythar
#
#  Instalação:
#    sudo cp barbearia.service /etc/systemd/system/
#    sudo sed -i 's|__INSTALL_DIR__|/opt/barbearia|g' /etc/systemd/system/barbearia.service
#    sudo sed -i 's|__SERVICE_USER__|ubuntu|g'        /etc/systemd/system/barbearia.service
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now barbearia
#
#  O instalar-linux.sh faz isso automaticamente se executado com sudo.
#  Substituições:
#    __INSTALL_DIR__  → caminho absoluto do sistema (ex: /opt/barbearia)
#    __SERVICE_USER__ → usuário Linux que roda o serviço (ex: ubuntu)
# =============================================================================

[Unit]
Description=Nythar — WhatsApp Bot + Dashboard
Documentation=https://github.com/seu-repo/barbearia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/node scripts/supervisor.js
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Carrega segredos e configuração do .env.local
EnvironmentFile=-__INSTALL_DIR__/.env.local

# Variáveis fixas de produção (sobrescrevem .env.local se conflitarem)
Environment=NODE_ENV=production
Environment=START_NGROK=0
Environment=OPEN_BROWSER=0
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

# Limite de descritores de arquivo (whatsapp-web.js abre muitos sockets)
LimitNOFILE=65536

# Reiniciar apenas em falhas, não em parada limpa (exit code 0)
SuccessExitStatus=0
RestartPreventExitStatus=0

[Install]
WantedBy=multi-user.target
